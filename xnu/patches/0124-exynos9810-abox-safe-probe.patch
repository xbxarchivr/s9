-	printf("SWEET ABOX: sysreg misc_con %#x l2_cache_con %#x\n", touch_rd(sys, 0x32c), touch_rd(sys, 0x328));
-	printf("SWEET ABOX: reading SysMMU 0x17e00000...\n");
+	if (abox_scan("as booted", cmu, sys, mmu)) {
+		goto open;
+	}
+	printf("SWEET ABOX: gpio_aud 0x17c60000...\n");
 	touch_wait(11000);         /* past one 10 s log flush: a hang leaves this line on UFS */
-	printf("SWEET ABOX: SysMMU ctrl %#x cfg %#x status %#x version %#x\n",
-	    touch_rd(mmu, 0x0), touch_rd(mmu, 0x4), touch_rd(mmu, 0x8), touch_rd(mmu, 0x34));
+	abox_peek("gpio_aud", gpio, 0x17c60000);
+	printf("SWEET ABOX: abox sram 0x17d00000...\n");
