@@ -133,6 +133,29 @@ touch_wr(vm_offset_t base, uint32_t off, uint32_t val)
 	__asm__ volatile("dsb osh" ::: "memory");
 }
 
+/*
+ * MMIO read that survives a bus error: osfmk/arm64/sleh.c sends a
+ * synchronous external abort taken at sweet_probe_ld to sweet_probe_fail.
+ * Returns 0 and the value, or 1 when the slave refused the read.
+ */
+int sweet_probe_rd32(vm_offset_t va, uint32_t *out);
+__asm__(
+	"	.text\n"
+	"	.p2align 2\n"
+	"	.globl _sweet_probe_rd32\n"
+	"_sweet_probe_rd32:\n"
+	"	.globl _sweet_probe_ld\n"
+	"_sweet_probe_ld:\n"
+	"	ldr	w2, [x0]\n"
+	"	dmb	oshld\n"
+	"	str	w2, [x1]\n"
+	"	mov	x0, #0\n"
+	"	ret\n"
+	"	.globl _sweet_probe_fail\n"
+	"_sweet_probe_fail:\n"
+	"	mov	x0, #1\n"
+	"	ret\n");
+
 static void
 touch_wait(unsigned ms)
 {
@@ -934,6 +957,35 @@ exy_smc(uint64_t fn, uint64_t a1, uint64_t a2, uint64_t a3)
 	return (int64_t)x0;
 }
 
+static bool
+abox_peek(const char *name, vm_offset_t va, uint32_t pa)
+{
+	uint32_t v = 0;
+	if (sweet_probe_rd32(va, &v)) {
+		printf("SWEET ABOX:   %-12s %#x ABORT\n", name, pa);
+		return false;
+	}
+	printf("SWEET ABOX:   %-12s %#x = %#x\n", name, pa, v);
+	return true;
+}
+
+/* true when the sysreg answers (MISC_CON, the register abox.c writes) */
+static bool
+abox_scan(const char *when, vm_offset_t cmu, vm_offset_t sys, vm_offset_t mmu)
+{
+	printf("SWEET ABOX: scan %s\n", when);
+	abox_peek("qch_sysreg", cmu + 0x3064, 0x17c03064);
+	abox_peek("qch_sysmmu", cmu + 0x3060, 0x17c03060);
+	abox_peek("sysreg+0", sys, 0x17c10000);
+	abox_peek("sysreg+0x104", sys + 0x104, 0x17c10104);
+	abox_peek("sysreg+0x204", sys + 0x204, 0x17c10204);
+	abox_peek("sysreg+0x300", sys + 0x300, 0x17c10300);
+	abox_peek("sysreg+0x328", sys + 0x328, 0x17c10328);
+	bool open = abox_peek("sysreg+0x32c", sys + 0x32c, 0x17c1032c);
+	abox_peek("sysmmu+0", mmu, 0x17e00000);
+	return open;
+}
