diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index becfb07..5d8a809 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -920,6 +920,20 @@ exy_audio_tone(const struct aspi *b)
  * clock gated: a line is logged and flushed (sweetlog: every 10 s) before
  * each read, so a hang names the block.
  */
+/* SMCCC call to EL3 (Samsung's exynos_smc): x0..x3 in, x0 out */
+static int64_t
+exy_smc(uint64_t fn, uint64_t a1, uint64_t a2, uint64_t a3)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3;
+	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	    "x14", "x15", "x16", "x17", "memory");
+	return (int64_t)x0;
+}
+
 static void
 exy_abox_probe(void)
 {
@@ -936,6 +950,17 @@ exy_abox_probe(void)
 	touch_wait(11000);         /* past one 10 s log flush: a hang leaves this line on UFS */
 	printf("SWEET ABOX: SFR ip_index %#x version %#x syspower ctrl %#x status %#x\n",
 	    touch_rd(sfr, 0x0), touch_rd(sfr, 0x4), touch_rd(sfr, 0x10), touch_rd(sfr, 0x14));
+	/*
+	 * boot-ios22 panicked reading the sysreg directly: the block is
+	 * TrustZone-protected until the domain's DTZPC is restored. Linux does
+	 * that after every AUD power-on (pmucal_local.c -> exynos_pd_tz_restore,
+	 * exynos-el3_mon.c): SMC_CMD_PREAPRE_PD_ONOFF 0x82000410, x1 =
+	 * EXYNOS_WAKEUP_PD_DOWN (1), x2 = DT pd-aud need_smc 0x17c10204.
+	 */
+	printf("SWEET ABOX: issuing DTZPC restore smc...\n");
+	touch_wait(11000);         /* past one 10 s log flush, as for the reads */
+	int64_t tz = exy_smc(0x82000410, 1, 0x17c10204, 0);
+	printf("SWEET ABOX: DTZPC restore smc(0x82000410, 1, 0x17c10204) = %lld\n", tz);
 	printf("SWEET ABOX: reading sysreg 0x17c10000...\n");
 	touch_wait(11000);         /* past one 10 s log flush: a hang leaves this line on UFS */
 	printf("SWEET ABOX: sysreg misc_con %#x l2_cache_con %#x\n", touch_rd(sys, 0x32c), touch_rd(sys, 0x328));
