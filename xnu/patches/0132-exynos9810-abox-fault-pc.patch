--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -1200,6 +1200,22 @@ abox_blob(const char *name, uint32_t *size)
  * registers are in the SFR: ABOX_CPU_R(x) 0x2C00 + 4x, PC 0x2C3C,
  * L2C_STATUS 0x2C40.
  */
+/* Calliope VA below 1 MB -> SRAM offset through its coarse table at SRAM 0x28000, or ~0 */
+static uint32_t
+abox_va_sram(vm_offset_t sram, uint32_t va)
+{
+	if (va >= 0x100000) {
+		return ~0u;
+	}
+	uint32_t e = abox_sp(sram + 0x28000 + 4 * (va >> 12));
+	uint32_t pa = (e & 0xfffff000u) + (va & 0xfff);
+	if (!(e & 2) || pa < 0x17d00000u || pa - 0x17d00000u >= ABOX_SRAM_SIZE) {
+		/* small page into the ABOX SRAM (0x17D00000) only; else identity guess */
+		return (e & 2) && (e & 0xfffff000u) < ABOX_SRAM_SIZE ? pa : ~0u;
+	}
+	return pa - 0x17d00000u;
+}
