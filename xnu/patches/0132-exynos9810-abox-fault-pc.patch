 	}
 	printf("SWEET ABOX: live L2C_STATUS %#x\n", abox_sp(sfr + 0x2c40));
+	/*
+	 * boot-ios32 + capstone on calliope_sram.bin: the data-abort vector
+	 * (0x2bfc) stores r0-r14 (lr = faulting PC, +0x38) into the block whose
+	 * address is the word at VA 0x955c, then calls 0x2708(DFSR, DFAR, PC),
+	 * which stores CPSR and the faulting PC at VA 0x954c / 0x9550 (strd to
+	 * literal 0x9544 + 8) before sending the IPC. VA 0-1 MB goes through
+	 * the coarse table at SRAM 0x28000 (boot-ios32 L1 entry 0x00028001):
+	 * print its 4 KB entries for the SRAM-sized range and read through it.
+	 */
+	for (uint32_t pg = 0; pg < 0x34; pg += 4) {
+		printf("SWEET ABOX: L2 VA %#07x: %08x %08x %08x %08x\n", pg << 12,
+		    abox_sp(sram + 0x28000 + 4 * pg), abox_sp(sram + 0x28004 + 4 * pg),
+		    abox_sp(sram + 0x28008 + 4 * pg), abox_sp(sram + 0x2800c + 4 * pg));
+	}
+	uint32_t info = abox_va_sram(sram, 0x954c), cp = abox_va_sram(sram, 0x955c);
+	if (info != ~0u) {
+		printf("SWEET ABOX: FAULT PC %#x cpsr %#x (VA 0x9550 = sram %#x)\n",
+		    abox_sp(sram + info + 4), abox_sp(sram + info), info + 4);
+	}
+	uint32_t ctx = cp != ~0u ? abox_sp(sram + cp) : ~0u, co = abox_va_sram(sram, ctx);
+	printf("SWEET ABOX: context block VA %#x -> sram %#x\n", ctx, co);
+	if (co != ~0u) {
+		for (int i = 0; i < 16; i += 4) {
+			printf("SWEET ABOX: ctx R%02d-R%02d %08x %08x %08x %08x%s\n", i, i + 3,
+			    abox_sp(sram + co + 4 * i), abox_sp(sram + co + 4 * i + 4),
+			    abox_sp(sram + co + 4 * i + 8), abox_sp(sram + co + 4 * i + 12),
+			    i == 12 ? " (R14 = faulting PC)" : "");
+		}
+	}
 }
 
