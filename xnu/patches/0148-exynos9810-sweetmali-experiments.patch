+/* s9mali experiments: GPU memory attribute of AS0 and a reset between jobs */
+bool
+SweetMali::configure(uint32_t memAttr, bool reset)
+{
+	bool ok = true;
+	IOLockLock(fLock);
+	if (memAttr != 0) {
+		fMemAttr = memAttr;
+		if (fPowered && !reset) {
+			(void)poll(AS0_STATUS, 0, 1, 10000);
+			wr(AS0_MEMATTR, fMemAttr);
+			wr(AS0_MEMATTR + 4, fMemAttr);
+			wr(AS0_COMMAND, 1);     /* AS_COMMAND_UPDATE */
+			(void)poll(AS0_STATUS, 0, 1, 10000);
+		}
+	}
+	if (reset) {
+		fPowered = false;
+		ok = powerUp();
+	}
+	IOLockUnlock(fLock);
+	return ok;
+}
+
+/* the same job as s9mali's, written through the kernel's own mapping */
+bool
+SweetMali::writeJob(uint32_t job, uint32_t target, uint32_t value)
+{
+	if (job < MALI_VA || job + 64u > MALI_VA + MALI_MEM_LEN) {
+		return false;
+	}
+	volatile uint32_t *j = (volatile uint32_t *)(fMem + (job - (uint32_t)MALI_VA));
+	for (int i = 0; i < 16; i++) {
+		j[i] = 0;
+	}
+	j[4] = 1u | 2u << 1 | 1u << 16;
+	j[8] = target;
+	j[10] = 6;
+	j[12] = value;
+	__asm__ volatile("dsb sy" ::: "memory");
+	return true;
+}
