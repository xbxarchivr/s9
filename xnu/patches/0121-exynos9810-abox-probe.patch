 	struct aspi bus = {
@@ -991,9 +1027,12 @@ exy_audio_probe(void)
 	delay(10);
 	uint32_t id = madera_rd(&bus, 0), crev = madera_rd(&bus, 1);
 	printf("SWEET AUDIO: CS47L93 register 0 = %#x (expect 0x6371), revision %#x\n", id, crev);
-	if (id == 0x6371 && on >= 2) {
