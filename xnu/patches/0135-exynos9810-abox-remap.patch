diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index 83ea2cd..670e9d4 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -1535,6 +1535,28 @@ exy_abox_boot(void)
 	printf("SWEET ABOX: firmware written (sram[0] %#x, dram[0] %#x, file %#x)\n", touch_rd(sram, 0), v,
 	    (uint32_t)fw_dram[0] | (uint32_t)fw_dram[1] << 8 | (uint32_t)fw_dram[2] << 16 | (uint32_t)fw_dram[3] << 24);
 
+	/*
+	 * boot-ios35: SRAM equals the image (word 0x60 = 0x0001e000), yet the
+	 * CA7's `ldr sp, [pc, #0x1c]` at 0x3c produced SP ~0x0a200063 once its
+	 * MMU was on (VA 0 -> PA 0 through its coarse table). The ABOX SFR
+	 * remaps CA7 addresses: ABOX_REMAP_MASK 0x24 / ABOX_REMAP_ADDR 0x28,
+	 * 9810 regmap defaults 0xFFF00000 / 0x17D00000 (PA 0x000xxxxx -> SRAM),
+	 * SYSTEM_CONFIG0 0x20 = 0x4444, DYN_CLOCK_OFF 0x30 = 0x7FFFFFFF.
+	 * abox.c never writes them (regcache keeps defaults = reset values);
+	 * here AUD was powered by S-Boot, so check and set them.
+	 */
+	static const struct { uint32_t off, def; const char *name; } sfrdef[] = {
+		{ 0x20, 0x00004444, "SYSTEM_CONFIG0" }, { 0x24, 0xfff00000, "REMAP_MASK" },
+		{ 0x28, 0x17d00000, "REMAP_ADDR" }, { 0x30, 0x7fffffff, "DYN_CLOCK_OFF" },
+	};
+	for (unsigned i = 0; i < sizeof(sfrdef) / sizeof(sfrdef[0]); i++) {
+		uint32_t cur = abox_sp(sfr + sfrdef[i].off);
+		if (cur != sfrdef[i].def && cur != 0xababababu) {
+			touch_wr(sfr, sfrdef[i].off, sfrdef[i].def);
+		}
+		printf("SWEET ABOX: SFR %s %#x was %#x, now %#x\n", sfrdef[i].name, sfrdef[i].off, cur,
+		    abox_sp(sfr + sfrdef[i].off));
+	}
 	touch_wr(sfr, 0x10, 1);                                  /* SYSPOWER_CTRL: DRAM on */
 	touch_wr(pmu, 0x415c, touch_rd(pmu, 0x415c) | 1);        /* ABOX_CPU_LOCAL_PWR_CFG */
 	printf("SWEET ABOX: starting the ABOX CPU...\n");
