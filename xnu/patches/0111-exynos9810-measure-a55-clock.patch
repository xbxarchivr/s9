 		printf("SWEET DVFS: mif -> %u: now %ld kHz\n", mif, exy_dvfs(EXY_DVFS_MIF, 1, 0));
 	}
+	printf("SWEET DVFS: A55 measured %u MHz\n", exy_cpu_mhz());
 	if (cpu) {
 		cpu = cpu > EXY_CL0_MAX_KHZ ? EXY_CL0_MAX_KHZ : cpu;
 		(void)exy_dvfs(EXY_DVFS_CPUCL0, 0, cpu);
-		printf("SWEET DVFS: cl0 -> %u: now %ld kHz\n", cpu, exy_dvfs(EXY_DVFS_CPUCL0, 1, 0));
+		delay(20000);   /* PLL relock and voltage ramp */
+		printf("SWEET DVFS: cl0 -> %u: now %ld kHz, measured %u MHz\n", cpu,
+		    exy_dvfs(EXY_DVFS_CPUCL0, 1, 0), exy_cpu_mhz());
