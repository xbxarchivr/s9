+struct aspi {
+	struct apin clk, mosi, miso, cs;
+};
+
+/* Madera register access: 32-bit address (read flag 0x80 in the top byte), 16 pad bits, 16-bit value */
+static uint32_t
+madera_rd(const struct aspi *b, uint32_t reg)
+{
+	apin_dat(&b->cs, 0);
+	delay(5);
+	(void)aspi_bits(&b->clk, &b->mosi, &b->miso, 0x80000000u | reg, 32);
+	(void)aspi_bits(&b->clk, &b->mosi, &b->miso, 0, 16);
+	uint32_t v = aspi_bits(&b->clk, &b->mosi, &b->miso, 0, 16);
+	apin_dat(&b->cs, 1);
+	delay(5);
+	return v;
+}
+
+static void
+madera_wr(const struct aspi *b, uint32_t reg, uint32_t val)
+{
+	apin_dat(&b->cs, 0);
+	delay(5);
+	(void)aspi_bits(&b->clk, &b->mosi, &b->miso, reg & 0x7fffffffu, 32);
+	(void)aspi_bits(&b->clk, &b->mosi, &b->miso, 0, 16);
+	(void)aspi_bits(&b->clk, &b->mosi, &b->miso, val & 0xffff, 16);
+	apin_dat(&b->cs, 1);
+	delay(5);
+}
+
+/*
+ * Stage 2 (sweetaudio=2): a tone from the earpiece, no ABOX. MCLK1 = PMU
+ * CLKOUT0 (+0xA00: SEL [13:8] = 1 TCXO 26 MHz, bit 0 = disable; Linux
+ * ra_enable_clkout, OSC_AUD = the /sound card's xclkout). SYSCLK straight
+ * from MCLK1, declared 24.576 MHz (code 2): 26 MHz runs it 5.8 % fast, only
+ * the pitch moves (the FLL comes later). Then as Linux's DAPM would: 48 kHz,
+ * TONE1 -> OUT3L mixer (source 0x04, -12 dB), DAC 3L -12 dB unmuted,
+ * OUT3 mono (DT out-mono), EP_SEL 0 = HPOUT3 = RECEIVER, OUT3L_ENA, wait for
+ * the write sequencer; boot-arg sweetaudiotone = seconds (default 3), then
+ * everything off again. Registers: include/linux/mfd/madera/registers.h.
+ */
+#define EXY_PMU_PA                0x14060000u
+#define EXY_PMU_CLKOUT0           0xa00u
+#define MADERA_R_TONE1            0x20
+#define MADERA_R_SYSCLK1          0x101
+#define MADERA_R_SAMPLE_RATE1     0x102
+#define MADERA_R_OUT_ENABLES1     0x400
+#define MADERA_R_OUT_PATH3L       0x420
+#define MADERA_R_DAC_VOL3L        0x421
+#define MADERA_R_OUT3LMIX_SRC1    0x6a0
+#define MADERA_R_OUT3LMIX_VOL1    0x6a1
+#define MADERA_R_IRQ1_RAW1        0x1880
+
+static void
+exy_audio_tone(const struct aspi *b)
+{
+	uint32_t secs = 3;
+	(void)PE_parse_boot_argn("sweetaudiotone", &secs, sizeof(secs));
+	vm_offset_t pmu = ml_io_map(EXY_PMU_PA, PAGE_SIZE);
+	if (!pmu) {
+		return;
+	}
+	uint32_t ck = touch_rd(pmu, EXY_PMU_CLKOUT0);
+	touch_wr(pmu, EXY_PMU_CLKOUT0, (ck & ~(0x3fu << 8) & ~1u) | 1u << 8);
+	delay(1000);
+	int boot = -1;
+	for (int i = 0; i < 100; i++) {
+		if (madera_rd(b, MADERA_R_IRQ1_RAW1) & 0x80) {
+			boot = i;
+			break;
+		}
+		delay(1000);
+	}
+	printf("SWEET AUDIO: tone: CLKOUT0 %#x -> %#x, codec boot done after %d ms\n",
+	    ck, touch_rd(pmu, EXY_PMU_CLKOUT0), boot);
+	madera_wr(b, MADERA_R_SYSCLK1, 2u << 8 | 0x40);         /* MCLK1, "24.576", SYSCLK_ENA */
+	madera_wr(b, MADERA_R_SAMPLE_RATE1, 0x03);              /* 48 kHz */
+	madera_wr(b, MADERA_R_TONE1, 0x0001);                   /* TONE1_ENA */
+	madera_wr(b, MADERA_R_OUT3LMIX_SRC1, 0x04);             /* Tone Generator 1 */
+	madera_wr(b, MADERA_R_OUT3LMIX_VOL1, 0x34u << 1);       /* -12 dB */
+	madera_wr(b, MADERA_R_DAC_VOL3L, 0x0200 | 0x68);        /* VU, unmuted, -12 dB */
+	madera_wr(b, MADERA_R_OUT_PATH3L, madera_rd(b, MADERA_R_OUT_PATH3L) | 0x1000);  /* OUT3_MONO */
+	uint32_t en = madera_rd(b, MADERA_R_OUT_ENABLES1) & ~0x8000u;  /* EP_SEL 0: HPOUT3 */
+	madera_wr(b, MADERA_R_OUT_ENABLES1, en | 0x0020);       /* OUT3L_ENA */
+	delay(40000);
+	printf("SWEET AUDIO: tone on: SYSCLK1 %#x RATE1 %#x TONE1 %#x MIX %#x/%#x DAC3L %#x PATH3L %#x OUTEN %#x IRQRAW %#x\n",
+	    madera_rd(b, MADERA_R_SYSCLK1), madera_rd(b, MADERA_R_SAMPLE_RATE1), madera_rd(b, MADERA_R_TONE1),
+	    madera_rd(b, MADERA_R_OUT3LMIX_SRC1), madera_rd(b, MADERA_R_OUT3LMIX_VOL1),
+	    madera_rd(b, MADERA_R_DAC_VOL3L), madera_rd(b, MADERA_R_OUT_PATH3L),
+	    madera_rd(b, MADERA_R_OUT_ENABLES1), madera_rd(b, MADERA_R_IRQ1_RAW1));
+	touch_wait(secs * 1000u);
+	madera_wr(b, MADERA_R_OUT_ENABLES1, madera_rd(b, MADERA_R_OUT_ENABLES1) & ~0x0020u);
+	delay(10000);
+	madera_wr(b, MADERA_R_TONE1, 0);
+	madera_wr(b, MADERA_R_SYSCLK1, 2u << 8);                /* SYSCLK off */
+	touch_wr(pmu, EXY_PMU_CLKOUT0, ck);                     /* CLKOUT0 as it was */
+	printf("SWEET AUDIO: tone off after %u s\n", secs);
+}
+
