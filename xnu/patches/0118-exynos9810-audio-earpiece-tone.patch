+	/* wiring found by boot-ios18 (all 6 orders tried): CLK GPP0-4, MOSI GPP0-5, MISO GPP0-6 */
+	struct aspi bus = {
+		.clk = {p0, EXY_GPP0, 4}, .mosi = {p0, EXY_GPP0, 5},
+		.miso = {p0, EXY_GPP0, 6}, .cs = {p0, EXY_GPP0, 7},
+	};
+	uint32_t c0 = touch_rd(p0, EXY_GPP0), d0 = touch_rd(p0, EXY_GPP0 + 4);
+	apin_dat(&bus.cs, 1);
+	apin_dat(&bus.clk, 0);
+	apin_dat(&bus.mosi, 0);
+	apin_con(&bus.cs, 1);
+	apin_con(&bus.clk, 1);
+	apin_con(&bus.mosi, 1);
+	apin_con(&bus.miso, 0);
+	delay(10);
+	uint32_t id = madera_rd(&bus, 0), rev = madera_rd(&bus, 1);
+	printf("SWEET AUDIO: CS47L93 register 0 = %#x (expect 0x6371), revision %#x\n", id, rev);
+	if (id == 0x6371 && on >= 2) {
+		exy_audio_tone(&bus);
 	}
 	touch_wr(p0, EXY_GPP0 + 4, d0);
 	touch_wr(p0, EXY_GPP0, c0);
