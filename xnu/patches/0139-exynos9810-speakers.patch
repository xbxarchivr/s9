+/*
+ * The two MAX98512 on GPP4-4 (SCL) / GPP4-5 (SDA): 0x39 left, 0x3a right (DT
+ * mono_stereo, sub_reg). rev 0x41 reads at 0x402, 0x600 is 0: the classic
+ * register map, not MAX98512B. Values from max98512_probe and hw_params,
+ * I2S slave, 16 bit, 48 kHz, BSEL 2 (32 BCLK per frame), RX channel 0 / 1.
+ * Deliberately quiet: no Samsung DSM speaker protection on this path, so
+ * digital gain -8 dB (0x20; 0x40 = 0 dB) and SPK_GAIN 1 instead of DT's 5.
+ */
+static void
+abox_amps(vm_offset_t p1, bool on)
+{
+	struct apin scl = {p1, EXY_GPP4, 4}, sda = {p1, EXY_GPP4, 5};
+	uint32_t c4 = touch_rd(p1, EXY_GPP4), d4 = touch_rd(p1, EXY_GPP4 + 4), u4 = touch_rd(p1, EXY_GPP4 + 8);
+	touch_wr(p1, EXY_GPP4 + 8, u4 & ~(0xfu << 16 | 0xfu << 20));
+	apin_con(&scl, 0);
+	apin_con(&sda, 0);
+	delay(20);
+	static const uint8_t addrs[2] = { MAX98512_ADDR, 0x3a };
+	for (int a = 0; a < 2; a++) {
+		uint8_t ad = addrs[a];
+		if (!on) {
+			(void)ai2c_write16(&sda, &scl, ad, 0x0038, 0);
+			(void)ai2c_write16(&sda, &scl, ad, 0x0400, 0);
+			continue;
+		}
+		static const uint16_t init[][2] = {
+			{0x0401, 0x01}, {0x0400, 0x00}, {0x003c, 0x00}, {0x001c, 0xff}, {0x001d, 0xff},
+			{0x0035, 0x20}, {0x003a, 0x01}, {0x0036, 0x01},
+			{0x003e, 0x1c}, {0x0040, 0x3e}, {0x003f, 0x01},
+			{0x0086, 0x05}, {0x0087, 0x02}, {0x0088, 0x01}, {0x0011, 0x00},
+			{0x0021, 0x00}, {0x0022, 0x22}, {0x0020, 0x40}, {0x0023, 0x08}, {0x0024, 0x88},
+			{0x0034, 0x00}, {0x0039, 0x00},
+		};
+		int err = 0, n = 0;
+		for (unsigned i = 0; i < sizeof(init) / sizeof(init[0]); i++) {
+			int e = ai2c_write16(&sda, &scl, ad, init[i][0], (uint8_t)init[i][1]);
+			if (e) {
+				err = e;
+				n++;
+			}
+			if (i == 0) {
+				delay(10000);   /* after SOFT_RESET */
+			}
+		}
+		n += ai2c_write16(&sda, &scl, ad, 0x0018, a ? 0x02 : 0x01) != 0;
+		n += ai2c_write16(&sda, &scl, ad, 0x0025, a ? 0x41 : 0x00) != 0;
+		n += ai2c_write16(&sda, &scl, ad, 0x0026, a ? 0x01 : 0x00) != 0;
+		n += ai2c_write16(&sda, &scl, ad, 0x0038, 1) != 0;
+		n += ai2c_write16(&sda, &scl, ad, 0x0400, 1) != 0;
+		delay(5000);
+		printf("SWEET AUDIO: amp %#x: %d failed writes (last %d); EN %d SHDN %d VOL %d GAIN %d MODE %d SR %d\n", ad, n, err,
+		    ai2c_read16(&sda, &scl, ad, 0x0038), ai2c_read16(&sda, &scl, ad, 0x0400),
+		    ai2c_read16(&sda, &scl, ad, 0x0035), ai2c_read16(&sda, &scl, ad, 0x003a),
+		    ai2c_read16(&sda, &scl, ad, 0x0020), ai2c_read16(&sda, &scl, ad, 0x0023));
+	}
+	touch_wr(p1, EXY_GPP4 + 4, d4);
+	touch_wr(p1, EXY_GPP4 + 8, u4);
+	touch_wr(p1, EXY_GPP4, c4);
+}
