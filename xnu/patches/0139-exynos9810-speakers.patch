+/* CS47L93 for AIF1 playback; returns the CLKOUT0 value to restore */
+static uint32_t
+abox_codec_up(const struct aspi *b, vm_offset_t pmu)
+{
+	/* the codec: as stage 2, then ASYNCCLK from FLL2 locked to the AIF1 bit clock (DT cirrus,asyncclk) */
+	uint32_t ck = touch_rd(pmu, EXY_PMU_CLKOUT0);
+	touch_wr(pmu, EXY_PMU_CLKOUT0, (ck & ~(0x3fu << 8) & ~1u) | 1u << 8);
+	delay(1000);
+	for (int i = 0; i < 100 && !(madera_rd(b, MADERA_R_IRQ1_RAW1) & 0x80); i++) {
+		delay(1000);
+	}
+	for (unsigned i = 0; i < sizeof(cs47l92_reva_16_patch) / sizeof(cs47l92_reva_16_patch[0]); i++) {
+		madera_wr(b, cs47l92_reva_16_patch[i][0], cs47l92_reva_16_patch[i][1]);
+	}
+	madera_wr(b, MADERA_R_SYSCLK1, 2u << 8 | 0x40);
+	madera_wr(b, MADERA_R_SAMPLE_RATE1, 0x03);
+	/* AIF1 pins: pinctrl-cs47l92 aif1 = GPIO5-8, alternate function 0 */
+	for (uint32_t g = 0x1708; g <= 0x170e; g += 2) {
+		madera_wr(b, g, madera_rd(b, g) & ~0x3ffu);
+	}
+	/* FLL2: 1.536 MHz AIF1BCLK (src 8) -> 98.304 MHz; madera_calc_fll: FRATIO 1, N 64, integer, gain 3 */
+	madera_wr(b, 0x193, 0);
+	madera_wr(b, 0x194, 0);
+	madera_wr(b, 0x195, 0);
+	madera_wr(b, 0x196, 8);
+	madera_wr(b, 0x199, (madera_rd(b, 0x199) & ~0x3cu) | 3u << 2);
+	madera_wr(b, 0x19a, (madera_rd(b, 0x19a) & ~0xf800u) | 1u << 11 | 2u << 12);
+	madera_wr(b, 0x192, 0x8000u | 64);
+	madera_wr(b, 0x191, madera_rd(b, 0x191) | 1);
+	int lock = -1;
+	for (int i = 0; i < 100; i++) {
+		if (madera_rd(b, 0x1881) & 0x200) {             /* FLL2_LOCK_STS1 */
+			lock = i;
+			break;
+		}
+		delay(1000);
+	}
+	printf("SWEET AUDIO: FLL2 lock after %d ms, raw status %#x\n", lock, madera_rd(b, 0x1881));
+	madera_wr(b, 0x112, 4u << 8 | 0x40 | 5);        /* ASYNCCLK: FLL2, 98.304 MHz, enabled */
+	madera_wr(b, 0x113, 3);                         /* ASYNC_SAMPLE_RATE_1 48 kHz */
+	madera_wr(b, 0x408, (madera_rd(b, 0x408) & ~0xf800u) | 8u << 11);       /* OUT rate: ASYNC 1 */
+	/* AIF1 slave, I2S, on ASYNC rate 1: BCLK_FREQ 11 = 1.536 MHz, 32 BCLK per frame, 16 bit slots */
+	madera_wr(b, 0x500, 11);
+	madera_wr(b, 0x503, 8u << 11);
+	madera_wr(b, 0x504, 2);
+	madera_wr(b, 0x506, 32);
+	madera_wr(b, 0x507, 0x1010);
+	madera_wr(b, 0x508, 0x1010);
+	madera_wr(b, 0x51a, 3);
+	/* HPOUT2 from AIF1RX1/2: mixer 0 dB, DAC -16 dB, about -34 dBFS with the tone (stage 2 was -36) */
+	madera_wr(b, MADERA_R_OUT2LMIX_SRC1, 0x20);
+	madera_wr(b, MADERA_R_OUT2LMIX_VOL1, 0x40u << 1);
+	madera_wr(b, MADERA_R_OUT2RMIX_SRC1, 0x21);
+	madera_wr(b, MADERA_R_OUT2RMIX_VOL1, 0x40u << 1);
+	madera_wr(b, MADERA_R_DAC_VOL2L, 0x60);
+	madera_wr(b, MADERA_R_DAC_VOL2R, 0x0200 | 0x60);
+	madera_wr(b, MADERA_R_OUT_PATH2L, madera_rd(b, MADERA_R_OUT_PATH2L) & ~0x1000u);
+	madera_wr(b, MADERA_R_OUT_ENABLES1, madera_rd(b, MADERA_R_OUT_ENABLES1) | 0x000c);
+	delay(40000);
+	return ck;
+}
