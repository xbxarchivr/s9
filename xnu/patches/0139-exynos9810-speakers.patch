+/* one byte to a 16-bit register; 0, -1 NACK, -2 clock stuck */
+static int
+ai2c_write16(const struct apin *sda, const struct apin *scl, uint8_t addr, uint16_t reg, uint8_t val)
+{
+	int err;
+	ai2c_line(sda, true);
+	if (!ai2c_scl_high(scl)) {
+		return -2;
+	}
+	ai2c_line(sda, false);                  /* START */
+	ai2c_line(scl, false);
+	if (!(err = ai2c_byte(sda, scl, (uint8_t)(addr << 1))) &&
+	    !(err = ai2c_byte(sda, scl, (uint8_t)(reg >> 8))) &&
+	    !(err = ai2c_byte(sda, scl, (uint8_t)reg))) {
+		err = ai2c_byte(sda, scl, val);
+	}
+	ai2c_line(sda, false);
+	(void)ai2c_scl_high(scl);
+	ai2c_line(sda, true);
+	return err;
+}
