+/*
+ * Exynos touch power: LDO35 then LDO43 (sec_ts_power order), only if their
+ * voltage selectors are the DT's 1.8 / 3.0 V; only the enable bits change.
+ */
+static bool
+exy_touch_power(void)
+{
+	if (!exy_acpm_init()) {
+		return false;
+	}
+	int l35 = exy_acpm_pmic(EXY_L35CTRL, 0), l43 = exy_acpm_pmic(EXY_L43CTRL, 0);
+	printf("SWEET TOUCH: S2MPS18 l35ctrl=%#x l43ctrl=%#x\n", l35, l43);
+	if (l35 < 0 || l43 < 0 || (l35 & 0x3f) != 0x2c || (l43 & 0x3f) != 0x30) {
+		printf("SWEET TOUCH: LDO35/LDO43 not readable or not 1.8/3.0 V; power untouched\n");
+		return false;
+	}
+	if ((l35 & 0xc0) != 0xc0) {
+		(void)exy_acpm_pmic(EXY_L35CTRL, 2u | 0xc0u << 8 | 0xc0u << 16);
+		delay(1000);
+	}
+	if ((l43 & 0xc0) != 0xc0) {
+		(void)exy_acpm_pmic(EXY_L43CTRL, 2u | 0xc0u << 8 | 0xc0u << 16);
+	}
+	delay(70000);   /* sec_ts_probe: 70 ms after power on */
+	l35 = exy_acpm_pmic(EXY_L35CTRL, 0);
+	l43 = exy_acpm_pmic(EXY_L43CTRL, 0);
+	bool on = l35 >= 0 && l43 >= 0 && (l35 & 0xc0) == 0xc0 && (l43 & 0xc0) == 0xc0;
+	printf("SWEET TOUCH: S2MPS18 l35ctrl=%#x l43ctrl=%#x: touch rails %s\n", l35, l43, on ? "on" : "OFF");
+	return on;
+}
