+/*
+ * Exynos: one PMIC request through the APM firmware (ACPM IPC, polled), as
+ * acpm_ipc_send_data + check_response with acpm_mfd's encoding: cmd[0] =
+ * seq << 16 | type << 8 | reg, cmd[1] = func (READ 0, UPDATE 2 | val << 8 |
+ * mask << 16); reply cmd[1]: byte bits 8-15, status bits 24-31. Returns the
+ * byte, or -1 (no channel / timeout) or -(0x100 + status).
+ */
+static struct {
+	vm_offset_t tx_rear, tx_front, tx_base, rx_rear, rx_front, rx_base;
+	uint32_t len, size, id, seq;
+} acpm;
+
+static bool
+exy_acpm_init(void)
+{
+	vm_offset_t init = st.sram + EXY_ACPM_INITDATA;
+	uint32_t tbl = touch_rd(init, 0x08), apmax = touch_rd(init, 0x18);
+	if (!tbl || tbl >= EXY_ACPM_SRAM_LEN || !apmax || apmax > 32) {
+		printf("SWEET TOUCH: no ACPM framework (tbl %#x ap_max %u)\n", tbl, apmax);
+		return false;
+	}
+	for (uint32_t i = 0; i < apmax; i++) {
+		vm_offset_t e = st.sram + tbl + 72 * i;         /* struct ipc_channel */
+		if (touch_rd(e, 0) != EXY_ACPM_MFD_CH) {
+			continue;
+		}
+		acpm.id = EXY_ACPM_MFD_CH;
+		acpm.tx_rear = st.sram + touch_rd(e, 16);       /* AP sends on ch.rx_* */
+		acpm.tx_front = st.sram + touch_rd(e, 20);
+		acpm.tx_base = st.sram + touch_rd(e, 24);
+		acpm.rx_rear = st.sram + touch_rd(e, 40);       /* and receives on ch.tx_* */
+		acpm.rx_front = st.sram + touch_rd(e, 44);
+		acpm.rx_base = st.sram + touch_rd(e, 48);
+		acpm.len = touch_rd(e, 52);
+		acpm.size = touch_rd(e, 56);
+		return acpm.len && acpm.size >= 8 && acpm.size <= 64;
+	}
+	printf("SWEET TOUCH: no ACPM channel %u\n", EXY_ACPM_MFD_CH);
+	return false;
+}
+
+static int
+exy_acpm_pmic(uint32_t reg, uint32_t cmd1)
+{
+	uint64_t deadline;
+	uint32_t front = touch_rd(acpm.tx_front, 0), next = (front + 1) % acpm.len;
+
+	nanoseconds_to_absolutetime(100 * NSEC_PER_MSEC, &deadline);
+	deadline += mach_absolute_time();
+	while (next == touch_rd(acpm.tx_rear, 0)) {             /* queue full */
+		if (mach_absolute_time() > deadline) {
+			return -1;
+		}
+		delay(10);
+	}
+	if (++acpm.seq == 64) {
+		acpm.seq = 1;
+	}
+	vm_offset_t slot = acpm.tx_base + acpm.size * front;
+	touch_wr(slot, 0, acpm.seq << 16 | 1u << 8 | (reg & 0xff));     /* PMIC page 1 */
+	touch_wr(slot, 4, cmd1);
+	for (uint32_t o = 8; o < acpm.size; o += 4) {
+		touch_wr(slot, o, 0);
+	}
+	touch_wr(acpm.tx_front, 0, next);
+	touch_wr(st.mbox, 0x08, (1u << acpm.id) << 16);        /* INTGR0: ring the APM */
+
+	nanoseconds_to_absolutetime(100 * NSEC_PER_MSEC, &deadline);
+	deadline += mach_absolute_time();
+	while (mach_absolute_time() < deadline) {
+		if (!(touch_rd(st.mbox, 0x28) & (1u << acpm.id))) {   /* INTSR1 */
+			delay(5);
+			continue;
+		}
+		uint32_t rear = touch_rd(acpm.rx_rear, 0), rfront = touch_rd(acpm.rx_front, 0);
+		for (uint32_t i = rear; i != rfront; i = (i + 1) % acpm.len) {
+			vm_offset_t r = acpm.rx_base + acpm.size * i;
+			if (((touch_rd(r, 0) >> 16) & 0x3f) != acpm.seq) {
+				continue;
+			}
+			uint32_t c1 = touch_rd(r, 4);
+			if (i != rear) {        /* keep the queue compact, as check_response */
+				for (uint32_t o = 0; o < acpm.size; o += 4) {
+					touch_wr(r, o, touch_rd(acpm.rx_base + acpm.size * rear, o));
+				}
+			}
+			rear = (rear + 1) % acpm.len;
+			touch_wr(acpm.rx_rear, 0, rear);
+			if (rear == touch_rd(acpm.rx_front, 0)) {
+				touch_wr(st.mbox, 0x20, 1u << acpm.id); /* INTCR1 */
+			}
+			uint32_t status = (c1 >> 24) & 0xff;
+			return status ? -(int)(0x100 + status) : (int)((c1 >> 8) & 0xff);
+		}
+		delay(5);
+	}
+	return -1;
+}
