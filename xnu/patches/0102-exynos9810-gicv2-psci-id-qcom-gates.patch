+static int
+sweet_dt_has_string(DTEntry entry, const char *prop_name, const char *want)
+{
+	void const *prop;
+	unsigned int size;
+	if (SecureDTGetProperty(entry, prop_name, &prop, &size) != kSuccess) {
+		return 0;
+	}
+	/* NUL-separated list; compare by hand (no libc in pexpert here) */
+	const char *p = (const char *)prop, *end = p + size;
+	while (p < end) {
+		const char *w = want;
+		while (p < end && *p != 0 && *p == *w) {
+			p++, w++;
+		}
+		if (p < end && *p == 0 && *w == 0) {
+			return 1;
+		}
+		while (p < end && *p != 0) {
+			p++;
+		}
+		p++;
+	}
+	return 0;
+}
+
+int
+sweet_is_exynos(void)
+{
+	if (sweet_exynos < 0) {
+		DTEntry root;
+		sweet_exynos = SecureDTLookupEntry(NULL, "/", &root) == kSuccess &&
+		    sweet_dt_has_string(root, "compatible", "samsung,exynos9810");
+	}
+	return sweet_exynos;
+}
