+/*
+ * Whole-GPU cache clean + invalidate, on top of the job's own start and end
+ * flushes: repeat jobs read stale descriptors without something like it
+ * (boot-ios48..50). Whether this is the real fix is what boot-ios51 tests.
+ */
+bool
+SweetMali::flushCaches(void)
+{
+	wr(GPU_IRQ_CLEAR, GPU_IRQ_CLEANED);
+	wr(GPU_CMD, 8);                 /* CLEAN_INV_CACHES */
+	bool ok = poll(GPU_IRQ_RAW, GPU_IRQ_CLEANED, GPU_IRQ_CLEANED, 10000);
+	wr(GPU_IRQ_CLEAR, GPU_IRQ_CLEANED);
+	return ok;
+}
+
