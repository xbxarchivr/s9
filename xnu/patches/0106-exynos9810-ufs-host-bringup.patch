+
+static int
+exy_apply_cfg(const struct exy_cfg *cfg, unsigned n, uint32_t period)
+{
+	for (unsigned j = 0; j < n; j++) {
+		uint32_t a = cfg[j].addr, v = cfg[j].val;
+		for (uint32_t i = 0; i < su.lanes; i++) {
+			int r = 0;
+			switch (cfg[j].lyr) {
+			case L_PCS_COMN:
+			case L_UNIPRO_STD:
+			case L_UNIPRO_DBG:
+				r = i ? 0 : exy_dme_set(UIC_MIB(a), v);
+				break;
+			case L_UNIPRO_DBG_PRD:
+				r = i ? 0 : exy_dme_set(UIC_MIB(a), period);
+				break;
+			case L_PCS_RX:
+				r = exy_dme_set(UIC_MIB_SEL(a, EXY_RX_LANE_0 + i), v);
+				break;
+			case L_PCS_TX:
+				r = exy_dme_set(UIC_MIB_SEL(a, i), v);
+				break;
+			case L_PCS_RX_PRD:
+				r = exy_dme_set(UIC_MIB_SEL(a, EXY_RX_LANE_0 + i), period);
+				break;
+			case L_PCS_TX_PRD:
+				r = exy_dme_set(UIC_MIB_SEL(a, i), period);
+				break;
+			case L_PMA_COMN:
+				if (i == 0) {
+					exy_pma_write(a, v);
+				}
+				break;
+			case L_PMA_TRSV:
+				exy_pma_write(a + 0x140 * i, v);
+				break;
+			case L_COMMON_WAIT:
+				if (i == 0) {
+					delay(v);
+				}
+				break;
+			}
+			if (r) {
+				printf("SWEET UFS: cal entry %u (0x%04x) lane %u: %d\n", j, a, i, r);
+				return EIO;
+			}
+		}
+	}
+	return 0;
+}
+
+/* ufs_cal_calib_hibern8_values */
+static int
+exy_calib_hibern8(void)
+{
+	uint32_t hw_min_tact, peer_tact, h8_time;
+
+	if (exy_dme_get(UIC_MIB_SEL(RX_MIN_ACTIVATETIME_CAP, EXY_RX_LANE_0), &hw_min_tact) ||
+	    exy_dme_get(UIC_MIB(PA_TACTIVATE), &peer_tact) ||
+	    exy_dme_get(UIC_MIB(PA_HIBERN8TIME), &h8_time)) {
+		return EIO;
+	}
+	if (peer_tact >= hw_min_tact &&
+	    exy_uic(UIC_DME_PEER_SET, UIC_MIB(PA_TACTIVATE), peer_tact + 1, NULL)) {
+		return EIO;
+	}
+	return exy_dme_set(UIC_MIB(PA_HIBERN8TIME), h8_time + 1) ? EIO : 0;
+}
+
+/*
+ * Everything up to a running UniPro link, from the state S-Boot leaves
+ * (device powered down, host gated). The request lists are set by
+ * ufs_take_over_host() afterwards.
+ */
+static int
+exy_link_up(void)
+{
+	io_wr(su.pmu, io_rd(su.pmu) | 1u);                              /* PHY isolation bypass */
+	io_wr(su.coh, (io_rd(su.coh) & ~0x300u) | 0x300u);             /* io-coherency */
+
+	/* FMPSECURITY & SMU (exynos_ufs_init) */
+	uint64_t sec = exy_smc(SMC_CMD_FMP_SECURITY, 0, SMU_EMBEDDED, CFG_DESCTYPE_3);
+	uint64_t smu = exy_smc(SMC_CMD_SMU, SMU_INIT, SMU_EMBEDDED, 0);
+	if (sec || smu) {
+		printf("SWEET UFS: FMP security %llx, SMU init %llx\n", sec, smu);
+	}
+
+	/* host software reset (exynos_ufs_host_reset) */
+	vs_wr(VS_FORCE_HCS, vs_rd(VS_FORCE_HCS) & ~(1u << 4));
+	vs_wr(VS_SW_RST, 0x3);
+	if (!exy_wait(EXY_VS + VS_SW_RST, 0x3, 0, NSEC_PER_MSEC)) {
+		printf("SWEET UFS: host software reset timed out\n");
+		return EIO;
+	}
+
+	/* init_host + clocks as pre_setup_clocks(on) / link_startup_notify(PRE) */
+	vs_wr(VS_REORDER, 0xa);
+	vs_wr(VS_TXPRDT, 0x8000000c);           /* PRDT_PREFECT_EN | PRDT_SET_SIZE(12) */
+	vs_wr(VS_RXPRDT, 0x0c);
+	vs_wr(VS_NEXUS, 0xffffffff);
+	vs_wr(VS_TMNEXUS, 0xffffffff);
+	vs_wr(VS_BURST, 0x98000003);            /* WLU_EN | BURST_LEN(3) */
+	vs_wr(VS_IOP_ACG, vs_rd(VS_IOP_ACG) & ~1u);
+	vs_wr(VS_UFS_ACG, vs_rd(VS_UFS_ACG) | 1u);
+	vs_wr(VS_FORCE_HCS, vs_rd(VS_FORCE_HCS) | CLK_STOP_CTRL_EN_ALL);
+	vs_wr(VS_CLKSTOP, vs_rd(VS_CLKSTOP) & ~CLK_STOP_ALL);
+	__builtin_arm_dsb(0xf);
+
+	/* device reset_n (exynos_ufs_dev_hw_reset) */
+	vs_wr(VS_GPIO_OUT, 0);
+	delay(5);
+	vs_wr(VS_GPIO_OUT, 1);
+
+	/* host controller enable */
+	ufs_wr(REG_HCE, 0);
+	ufs_wr(REG_HCE, 1);
+	delay(1000);
+	if (!exy_wait(REG_HCE, 1, 1, NSEC_PER_SEC) ||
+	    !exy_wait(REG_HCS, HCS_UCRDY, HCS_UCRDY, NSEC_PER_SEC)) {
+		printf("SWEET UFS: host enable failed (hce 0x%x hcs 0x%x)\n",
+		    ufs_rd(REG_HCE), ufs_rd(REG_HCS));
+		return EIO;
+	}
+
+	/* UniPro MCLK: S-Boot leaves its period in PA_DBG_CLK_PERIOD */
+	uint32_t period = 0, mclk = EXY_MCLK_FALLBACK;
+	if (exy_dme_get(UIC_MIB(PA_DBG_CLK_PERIOD), &period) == 0 && period) {
+		mclk = 1000000000u / period;
+	}
+	period = 1000000000u / mclk;
+	vs_wr(VS_V2P1_CTRL, vs_rd(VS_V2P1_CTRL) | (1u << 16));         /* IA_TICK_SEL */
+	vs_wr(VS_1US_TO_CNT, (mclk / 1000000u) & 0x3ff);
+
+	uint32_t rx = 0, tx = 0;
+	su.lanes = 2;
+	if (exy_dme_get(UIC_MIB(PA_AVAILRXDATALANES), &rx) == 0 && rx) {
+		su.lanes = rx;
+	}
+	if (exy_dme_get(UIC_MIB(PA_AVAILTXDATALANES), &tx) == 0 && tx && tx < su.lanes) {
+		su.lanes = tx;
+	}
+
+	int error = exy_apply_cfg(exy_init_cfg, sizeof(exy_init_cfg) / sizeof(exy_init_cfg[0]), period);
+	if (error) {
+		return error;
+	}
+	int r = exy_uic(UIC_DME_LINK_STARTUP, 0, 0, NULL);
+	uint32_t gen_err = io_rd(su.unipro + UNIP_LINKSTARTUP_RESULT);
+	if (r < 0 || gen_err || !(ufs_rd(REG_HCS) & HCS_DP)) {
+		printf("SWEET UFS: link startup failed (%d, gen_err 0x%x, hcs 0x%x)\n",
+		    r, gen_err, ufs_rd(REG_HCS));
+		return EIO;
+	}
+	error = exy_calib_hibern8();
+	if (!error) {
+		error = exy_apply_cfg(exy_post_init_cfg,
+		    sizeof(exy_post_init_cfg) / sizeof(exy_post_init_cfg[0]), period);
+	}
+	printf("SWEET UFS: Exynos link up: mclk %u Hz, %u lanes, hcs 0x%x\n",
+	    mclk, su.lanes, ufs_rd(REG_HCS));
+	return error;
+}
