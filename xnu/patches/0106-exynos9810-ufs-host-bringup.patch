+/* ---- Exynos 9810 host bring-up (s9/exynos/x5.c, ufs-exynos.c, ufs-cal-9810.c) ---- */
+
+#define vs_rd(o)        ufs_rd(EXY_VS + (o))
+#define vs_wr(o, v)     ufs_wr(EXY_VS + (o), (v))
+
+static inline uint32_t
+io_rd(vm_offset_t va)
+{
+	return *(volatile uint32_t *)va;
+}
+
+static inline void
+io_wr(vm_offset_t va, uint32_t v)
+{
+	*(volatile uint32_t *)va = v;
+}
+
+/* SMCCC 1.0 call to the secure firmware; x0 is the result. */
+static uint64_t
+exy_smc(uint64_t fid, uint64_t a1, uint64_t a2, uint64_t a3)
+{
+	register uint64_t x0 __asm__("x0") = fid;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3;
+	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	    "x14", "x15", "x16", "x17", "cc", "memory");
+	return x0;
+}
+
+/* Spin until (reg & mask) == want or ns pass. */
+static bool
+exy_wait(uint32_t off, uint32_t mask, uint32_t want, uint64_t ns)
+{
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(ns, &deadline);
+	deadline += mach_absolute_time();
+	while ((ufs_rd(off) & mask) != want) {
+		if (mach_absolute_time() > deadline) {
+			return false;
+		}
+		delay(1);
+	}
+	return true;
+}
+
+/* One UIC command; returns the UIC result code, or -1/-2 (not ready/timeout). */
+static int
+exy_uic(uint32_t op, uint32_t arg1, uint32_t arg3, uint32_t *get)
+{
+	if (!(ufs_rd(REG_HCS) & HCS_UCRDY)) {
+		return -1;
+	}
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	ufs_wr(REG_UIC_ARG1, arg1);
+	ufs_wr(REG_UIC_ARG2, 0);
+	ufs_wr(REG_UIC_ARG3, arg3);
+	__builtin_arm_dsb(0xf);
+	delay(1000);                            /* ~1 ms before each DME, as the cal does */
+	ufs_wr(REG_UIC_CMD, op);
+	if (!exy_wait(REG_IS, IS_UCCS, IS_UCCS, NSEC_PER_SEC)) {
+		return -2;
+	}
+	ufs_wr(REG_IS, IS_UCCS);
+	if (get) {
+		*get = ufs_rd(REG_UIC_ARG3);
+	}
+	return (int)(ufs_rd(REG_UIC_ARG2) & 0xff);
+}
+
+static int
+exy_dme_set(uint32_t attr, uint32_t val)
+{
+	return exy_uic(UIC_DME_SET, attr, val, NULL);
+}
+
+static int
+exy_dme_get(uint32_t attr, uint32_t *val)
+{
+	return exy_uic(UIC_DME_GET, attr, 0, val);
+}
+
+/* M-PHY PMA write with MPHY_APBCLK_STOP lifted around it (phy_pma_writel). */
+static void
+exy_pma_write(uint32_t reg, uint32_t val)
+{
+	uint32_t c = vs_rd(VS_CLKSTOP);
+	vs_wr(VS_CLKSTOP, c & ~(1u << 3));
+	ufs_wr(EXY_PMA + reg, val);
+	vs_wr(VS_CLKSTOP, c | (1u << 3));
+}
