+/*
+ * NOP OUT or a flag query in slot 0 (command type 1, NEXUS bit cleared as
+ * exynos_ufs_set_nexus_t_xfer_req does for device-management requests).
+ * The caller fills the request UPIU at the UCD; returns the response UPIU.
+ */
+static const uint8_t *
+exy_devman(uint8_t resp_type)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	uint8_t *cmd = (uint8_t *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD;
+
+	bzero(utrd, sizeof(*utrd));
+	bzero(cmd + EXY_RESP_OFF, EXY_RESP_OFF);
+	utrd->dw0 = (1u << 28) | (1u << 24);
+	utrd->dw2 = 0x0f;
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = EXY_RESP_OFF << 16 | EXY_RESP_OFF;
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, EXY_PRDT_OFF);
+	__builtin_arm_dsb(0xf);
+
+	vs_wr(VS_NEXUS, vs_rd(VS_NEXUS) & ~1u);
+	ufs_wr(REG_UTRLDBR, 1);
+	bool done = exy_wait(REG_UTRLDBR, 1, 0, 600 * NSEC_PER_MSEC);
+	if (!done) {
+		ufs_wr(REG_UTRLCLR, ~1u);
+	}
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	vs_wr(VS_NEXUS, vs_rd(VS_NEXUS) | 1u);
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, EXY_PRDT_OFF);
+	const uint8_t *resp = cmd + EXY_RESP_OFF;
+	return done && (utrd->dw2 & 0xff) == 0 && resp[0] == resp_type ? resp : NULL;
+}
+
+/* fDeviceInit flag: opcode 0x06 SET_FLAG (write), 0x05 READ_FLAG (read). */
+static const uint8_t *
+exy_query_fdeviceinit(uint8_t opcode)
+{
+	uint8_t *cmd = (uint8_t *)(su.dma + DMA_UCD);
+
+	bzero(cmd, EXY_RESP_OFF);
+	cmd[0] = 0x16;                          /* QUERY REQUEST */
+	cmd[5] = opcode == 0x06 ? 0x81 : 0x01;  /* query function: standard write / read */
+	cmd[12] = opcode;
+	cmd[13] = 0x01;                         /* IDN fDeviceInit */
+	return exy_devman(0x36);                /* QUERY RESPONSE */
+}
+
+/* After the link: NOP OUT until NOP IN, then fDeviceInit set and cleared. */
+static int
+exy_device_init(void)
+{
+	uint8_t *cmd = (uint8_t *)(su.dma + DMA_UCD);
+	const uint8_t *r = NULL;
+
+	for (int i = 0; i < 10 && !r; i++) {
+		bzero(cmd, EXY_RESP_OFF);       /* NOP OUT: all zero */
+		r = exy_devman(0x20);
+	}
+	if (!r) {
+		printf("SWEET UFS: no NOP IN from the device\n");
+		return EIO;
+	}
+	r = exy_query_fdeviceinit(0x06);
+	if (!r || r[6]) {
+		printf("SWEET UFS: SET_FLAG fDeviceInit failed (response 0x%x)\n", r ? r[6] : 0xff);
+		return EIO;
+	}
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &deadline);
+	deadline += mach_absolute_time();
+	do {
+		r = exy_query_fdeviceinit(0x05);
+		if (r && !r[6] && !(r[23] & 1)) {
+			return 0;
+		}
+		delay(1000);
+	} while (mach_absolute_time() < deadline);
+	printf("SWEET UFS: fDeviceInit did not clear\n");
+	return EIO;
+}
