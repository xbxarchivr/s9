+/*
+ * Calliope -> AP (abox.c abox_irq_handler): a message at SRAM ipc_rx 0x30300,
+ * acknowledged by clearing ipc_rx_ack 0x305fc. Polled; no AP interrupt yet.
+ */
+static bool abox_ready;
+static uint32_t abox_ver;
+static unsigned abox_rx_lines;
+
+static void
+abox_rx(vm_offset_t sram)
+{
+	if (!abox_sp(sram + 0x305fc)) {
+		return;
+	}
+	uint32_t id = abox_sp(sram + 0x30300), task = abox_sp(sram + 0x30304), type = abox_sp(sram + 0x30308);
+	uint32_t p1 = abox_sp(sram + 0x3030c), p2 = abox_sp(sram + 0x30310), p3 = abox_sp(sram + 0x30314);
+	if (abox_rx_lines < 60) {
+		abox_rx_lines++;
+		printf("SWEET ABOX: rx ipcid %u task %u msg %#x %#x %#x %#x\n", id, task, type, p1, p2, p3);
+	}
+	if (id == 1 && type == 3) {     /* IPC_SYSTEM, ABOX_BOOT_DONE */
+		abox_ver = p3;
+		abox_ready = true;
+	}
+	touch_wr(sram, 0x305fc, 0);
+}
+
 /* Calliope VA below 1 MB -> SRAM offset through its coarse table at SRAM 0x28000, or ~0 */
 static uint32_t
 abox_va_sram(vm_offset_t sram, uint32_t va)
