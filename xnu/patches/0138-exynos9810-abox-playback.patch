 			    " rx ipcid %#x msg %#x p1 %#x p3 %#x mmu int %#x far %#x/%#x\n", t,
@@ -1614,7 +1641,8 @@ exy_abox_boot(void)
 			    abox_sp(mmu + 0x60), abox_sp(mmu + 0x70), abox_sp(mmu + 0x80));
