+/*
+ * Link startup leaves the link in PWM-G1 (a few Mbit/s per lane). Switch it
+ * to HS-G3 rate B on both lanes, FAST mode, as Linux does (exynos9810.dtsi
+ * ufs,pmd-attr-gear 3 / lane 2; ufshcd_change_power_mode with the
+ * ufs-cal-9810 pre/post PMC tables). Returns 0 or an errno; the link stays
+ * usable in PWM if the HS attempt is refused before the mode change.
+ */
+static int
+exy_power_mode(void)
+{
+	uint32_t rx_gear = 0, tx_gear = 0, mode = 0;
+
+	if (exy_dme_get(UIC_MIB(PA_MAXRXHSGEAR), &rx_gear) ||
+	    exy_uic(UIC_DME_PEER_GET, UIC_MIB(PA_MAXRXHSGEAR), 0, &tx_gear)) {
+		printf("SWEET UFS: cannot read the HS gear capabilities\n");
+		return EIO;
+	}
+	uint32_t gear = MIN(MIN(rx_gear, tx_gear), (uint32_t)EXY_HS_GEAR_MAX);
+	if (gear == 0) {
+		printf("SWEET UFS: no HS gear (rx %u tx %u)\n", rx_gear, tx_gear);
+		return ENOTSUP;
+	}
+
+	/* ufs_cal_pre_pmc: the table is for G3; lower gears differ only in PMA 0x128/0x134 */
+	int error = exy_apply_cfg(exy_hs_g3_cfg, sizeof(exy_hs_g3_cfg) / sizeof(exy_hs_g3_cfg[0]), 0);
+	if (error) {
+		return error;
+	}
+	if (exy_dme_set(UIC_MIB(PA_RXGEAR), gear) ||
+	    exy_dme_set(UIC_MIB(PA_ACTIVERXDATALANES), su.lanes) ||
+	    exy_dme_set(UIC_MIB(PA_RXTERMINATION), 1) ||
+	    exy_dme_set(UIC_MIB(PA_TXGEAR), gear) ||
+	    exy_dme_set(UIC_MIB(PA_ACTIVETXDATALANES), su.lanes) ||
+	    exy_dme_set(UIC_MIB(PA_TXTERMINATION), 1) ||
+	    exy_dme_set(UIC_MIB(PA_HSSERIES), PA_HS_MODE_B)) {
+		printf("SWEET UFS: power mode attributes refused\n");
+		return EIO;
+	}
+
+	/* the mode change itself completes with UIC power mode status (UPMS) */
+	int r = exy_uic(UIC_DME_SET, UIC_MIB(PA_PWRMODE), PMD_FAST << 4 | PMD_FAST, NULL);
+	bool upms = exy_wait(REG_IS, IS_UPMS, IS_UPMS, NSEC_PER_SEC);
+	ufs_wr(REG_IS, IS_UPMS);
+	uint32_t upmcrs = io_rd(su.unipro + UNIP_DME_PWR_IND_RESULT) & 0x7;
+	if (r || !upms || upmcrs != PWR_LOCAL) {
+		printf("SWEET UFS: power mode change failed (%d, upms %d, upmcrs %u)\n", r, upms, upmcrs);
+		return EIO;
+	}
+
+	/* ufs_cal_post_pmc: wait for CDR/AFC lock on each lane, re-kicking it */
+	for (uint32_t lane = 0; lane < su.lanes; lane++) {
+		uint32_t base = 0x140 * lane;
+		int i;
+		for (i = 0; i < 100; i++) {
+			delay(40);
+			if (exy_pma_read(base + 0x1fc) & 0x40) {
+				break;
+			}
+			delay(1);
+			exy_pma_write(base + 0xf0, 0x7f);
+			exy_pma_write(base + 0xf0, 0xff);
+		}
+		if (i == 100) {
+			printf("SWEET UFS: lane %u CDR/AFC did not lock\n", lane);
+			return EIO;
+		}
+	}
+	(void)exy_dme_get(UIC_MIB(PA_PWRMODE), &mode);
+	printf("SWEET UFS: power mode HS-G%u rate B, %u lanes (PA_PWRMODE 0x%x)\n", gear, su.lanes, mode);
+	return 0;
+}
