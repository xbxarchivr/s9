+/* Time reading mib MiB from the start of the partition (boot-arg ufsbench=0: off). */
+static void
+exy_bench(const char *what, uint32_t mib)
+{
+	uint64_t t0 = mach_absolute_time(), ns;
+	uint32_t done = 0;
+
+	for (; done < mib; done++) {
+		if (ufs_read_blocks(su.first_block + done * (BOUNCE_SIZE / UFS_BLOCK), BOUNCE_SIZE / UFS_BLOCK)) {
+			break;
+		}
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	printf("SWEET UFS: %s: read %u MiB in %llu ms (%llu KiB/s)\n", what, done, ns / NSEC_PER_MSEC,
+	    ns ? (uint64_t)done * 1024 * NSEC_PER_SEC / ns : 0);
+}
