+static uint32_t
+exy_pma_read(uint32_t reg)
+{
+	uint32_t c = vs_rd(VS_CLKSTOP);
+	vs_wr(VS_CLKSTOP, c & ~(1u << 3));
+	uint32_t v = ufs_rd(EXY_PMA + reg);
+	vs_wr(VS_CLKSTOP, c | (1u << 3));
+	return v;
+}
