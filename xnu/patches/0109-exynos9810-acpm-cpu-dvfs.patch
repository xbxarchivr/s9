+/*
+ * One PMIC request, acpm_mfd's encoding: cmd[0] = type << 8 | reg, cmd[1] =
+ * func (READ 0, UPDATE 2 | val << 8 | mask << 16); reply cmd[1]: byte bits
+ * 8-15, status bits 24-31. Returns the byte, or -1 (timeout) or
+ * -(0x100 + status).
+ */
+static int
+exy_acpm_pmic(uint32_t reg, uint32_t cmd1)
+{
+	uint32_t cmd[4] = {1u << 8 | (reg & 0xff), cmd1, 0, 0};    /* PMIC page 1 */
+	if (exy_acpm_xfer(&acpm_mfd, cmd)) {
+		return -1;
+	}
+	uint32_t status = (cmd[1] >> 24) & 0xff;
+	return status ? -(int)(0x100 + status) : (int)((cmd[1] >> 8) & 0xff);
+}
+
+/*
+ * Exynos 9810 DVFS through the APM (acpm_dvfs.c, DT acpm-ipc-channel 5):
+ * cmd[0] = domain (cal-id & 0xff: 0 MIF, 1 INT, 2 CPUCL0 = A55, 3 CPUCL1 =
+ * M3, 4 G3D), cmd[1] = kHz, cmd[2] = FREQ_REQ 0 / FREQ_GET 1. The APM
+ * picks the voltage from its own ECT table, as for Linux's cpufreq.
+ */
+#define EXY_ACPM_DVFS_CH  5u
+#define EXY_DVFS_MIF      0u
+#define EXY_DVFS_CPUCL0   2u
+#define EXY_CL0_MAX_KHZ   1794000u    /* DT cpufreq-ufc: cl0 limits */
+#define EXY_MIF_MAX_KHZ   2093000u
+
+static long
+exy_dvfs(uint32_t dom, uint32_t req, uint32_t khz)
+{
+	uint32_t cmd[4] = {dom, khz, req, 0};
+	if (exy_acpm_xfer(&acpm_dvfs, cmd)) {
+		return -1;
+	}
+	return cmd[1];
+}
+
+/*
+ * Report the clocks S-Boot left (always) and raise the A55 cluster and MIF
+ * when asked: boot-args sweetcpufreq / sweetmiffreq, kHz, 0 = leave.
+ */
+static void
+exy_cpu_dvfs(void)
+{
+	static const char *const names[] = {"mif", "int", "cl0", "cl1", "g3d"};
+	uint32_t cpu = 0, mif = 0;
+	(void)PE_parse_boot_argn("sweetcpufreq", &cpu, sizeof(cpu));
+	(void)PE_parse_boot_argn("sweetmiffreq", &mif, sizeof(mif));
+	if (!exy_acpm_init(&acpm_dvfs, EXY_ACPM_DVFS_CH)) {
+		return;
+	}
+	for (uint32_t d = 0; d < 5; d++) {
+		printf("SWEET DVFS: %s %ld kHz\n", names[d], exy_dvfs(d, 1, 0));
+	}
+	if (mif) {
+		mif = mif > EXY_MIF_MAX_KHZ ? EXY_MIF_MAX_KHZ : mif;
+		(void)exy_dvfs(EXY_DVFS_MIF, 0, mif);
+		printf("SWEET DVFS: mif -> %u: now %ld kHz\n", mif, exy_dvfs(EXY_DVFS_MIF, 1, 0));
+	}
+	if (cpu) {
+		cpu = cpu > EXY_CL0_MAX_KHZ ? EXY_CL0_MAX_KHZ : cpu;
+		(void)exy_dvfs(EXY_DVFS_CPUCL0, 0, cpu);
+		printf("SWEET DVFS: cl0 -> %u: now %ld kHz\n", cpu, exy_dvfs(EXY_DVFS_CPUCL0, 1, 0));
+	}
+}
