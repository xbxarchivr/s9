+/*
+ * abox_rmem through 1 MB windows: boot-ios26 panicked mapping all 40 MB at
+ * once (kmem_alloc(..., 41943040, ...) failed with 3 in io_map). Copies len
+ * bytes of src (or nothing) to rmem + off and zero-fills up to total.
+ */
+#define ABOX_RM_WIN      0x100000u
+static void
+abox_rm_write(uint32_t off, const uint8_t *src, uint32_t len, uint32_t total)
+{
+	for (uint32_t w = 0; w < total; w += ABOX_RM_WIN) {
+		uint32_t n = total - w < ABOX_RM_WIN ? total - w : ABOX_RM_WIN;
+		uint32_t have = len > w ? (len - w < n ? len - w : n) : 0;
+		vm_offset_t va = ml_io_map(ABOX_RMEM_PA + off + w, ABOX_RM_WIN);
+		abox_copy(va, have ? src + w : NULL, have, n);
+		ml_io_unmap(va, ABOX_RM_WIN);
+	}
+}
